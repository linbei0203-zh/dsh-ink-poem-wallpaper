[["岁暮锄犁傍空室，呼儿登山收橡实。","张籍","野老歌","唐","mountain,sunset"],["无人收废帐，归马识残旗。","张籍","没蕃故人","唐","seclusion,journey"],["谁言寸草心，报得三春晖。","孟郊","游子吟","唐","sunset,spring"],["天山雪后海风寒，横笛偏吹行路难。","李益","从军北征","唐","mountain,water,snow"],["不知何处吹芦管，一夜征人尽望乡。","李益","夜上受降城闻笛","唐","moon,wind,flower"],["早雁忽为双，惊秋风水凉。","李益","水宿闻雁","唐","wind,bird,autumn"],["路出寒云外，人归暮雪时。","卢纶","送李端","唐","snow,sunset,journey"],["云开远见洛阳城，犹见孤帆一日程。","卢纶","晚次鄂州","唐","water,seclusion,sunset"],["林暗草惊风，将军夜引弓。","卢纶","塞下曲","唐","moon,wind"],["世事茫茫难自料，春愁黯黯独成眠。","韦应物","寄李儋元锡","唐","seclusion,spring"],["楚江微雨里，建业暮钟时。","韦应物","赋得暮雨送李曹","唐","water,rain,sunset"],["落帆逗淮镇，停舫临孤驿。","韦应物","夕次盱眙县","唐","water,seclusion,sunset"],["归棹洛阳人，残钟广陵树。","韦应物","初发杨子寄元大校书","唐","sunset,journey"],["春潮带雨晚来急，野渡无人舟自横。","韦应物","滁州西涧","唐","water,rain,seclusion"],["风枝惊暗鹊，露草泣寒虫。","戴叔伦","江乡故人偶集客舍","唐","rain,snow,wind"],["日暮秋风起，萧萧枫树林。","戴叔伦","题三闾大夫庙","唐","wind,sunset,autumn"],["青海戍头空有月，黄沙碛里本无春。","柳中庸","凉州曲","唐","moon,water,spring"],["三春白雪归青冢，万里黄河绕黑山。","柳中庸","征人怨","唐","mountain,water,snow"],["板桥人渡泉声，茅檐日午鸡鸣。","顾况","过山农家","唐","water,seclusion"],["野客漱流时，杯粘落花片。","顾况","石窦泉","唐","flower,sunset,autumn"],["空山无鸟迹，何物如人意。","顾况","石上藤","唐","mountain,bird,seclusion"],["山店门前一妇人，哀哀夜哭向秋云。","李端","宿石涧店闻妇人哭","唐","moon,mountain,autumn"],["风吹城上树，草没城边路。","李端","芜城","唐","wind,journey"],["秋风落叶满空山，古寺残灯石壁间。","皎然","秋晚宿破山寺","唐","mountain,wind,seclusion"],["近种篱边菊，秋来未著花。","皎然","寻陆鸿渐不遇","唐","flower,autumn"],["钓罢归来不系船，江村月落正堪眠。","司空曙","江村即事","唐","moon,water,sunset"],["孤灯寒照雨，深竹暗浮烟。","司空曙","云阳馆与韩绅宿别","唐","rain,snow,flower"],["雨中黄叶树，灯下白头人。","司空曙","喜外弟卢纶见宿","唐","rain,autumn"],["无将故人酒，不及石尤风。","司空曙","留卢秦卿","唐","mountain,wind"],["垂死病中惊坐起，暗风吹雨入寒窗。","元稹","闻乐天授江州司马","唐","rain,snow,wind"],["姑苏城外寒山寺，夜半钟声到客船。","张继","枫桥夜泊","唐","moon,mountain,water"],["寥落古行宫，宫花寂寞红。","元稹","行宫","唐","flower,seclusion,sunset"],["渔翁夜傍西岩宿，晓汲清湘燃楚竹。","柳宗元","渔翁","唐","moon,mountain,flower"],["孤舟蓑笠翁，独钓寒江雪。","柳宗元","江雪","唐","water,snow,seclusion"],["今夜偏知春气暖，虫声新透绿窗纱。","刘方平","月夜","唐","moon,spring"],["落日清江里，荆歌艳楚腰。","刘方平","采莲曲","唐","water,sunset,autumn"],["飞雪带春风，徘徊乱绕空。","刘方平","春雪","唐","snow,wind,spring"],["忽如一夜春风来，千树万树梨花开。","岑参","白雪歌送武判官归京","唐","moon,wind,flower"],["苜蓿峰边逢立春，葫芦河上泪沾巾。","岑参","苜蓿峰寄家人","唐","mountain,water,flower"],["今夜未知何处宿，平沙万里绝人烟。","岑参","碛中作","唐","moon,rain"],["梁园日暮乱飞鸦，极目箫条三两家。","岑参","山房春事","唐","bird,sunset"],["山风吹空林，飒飒如有人。","岑参","暮秋山行节选","唐","mountain,wind"],["野寺荒台晚，寒天古木悲。","岑参","题三会寺仓颉造字台","唐","snow,seclusion,sunset"],["流落征南将，曾驱十万师。","刘长卿","送李中丞归汉阳别业","唐","sunset,autumn,journey"],["古台摇落后，秋入望乡心。","刘长卿","秋日登吴公台上寺远眺","唐","sunset,autumn,journey"],["白云依静渚，芳草闭闲门。","刘长卿","寻南溪常道士","唐","water,seclusion,spring"],["荷笠带斜阳，青山独归远。","刘长卿","送灵澈","唐","mountain,flower,seclusion"],["柴门闻犬吠，风雪夜归人。","刘长卿","逢雪宿芙蓉山主人","唐","moon,snow,wind"],["一树寒梅白玉条，迥临村路傍溪桥。","张谓","早梅","唐","water,snow,flower"],["无边落木萧萧下，不尽长江滚滚来。","杜甫","登高","唐","water,wind,sunset"],["花近高楼伤客心，万方多难此登临。","杜甫","登楼","唐","flower,journey"],["西山白雪三城戍，南浦清江万里桥。","杜甫","野望","唐","mountain,water,snow"],["岁暮阴阳催短景，天涯霜雪霁寒宵。","杜甫","阁夜","唐","moon,snow,sunset"],["舍南舍北皆春水，但见群鸥日日来。","杜甫","客至","唐","bird,seclusion,spring"],["正是江南好风景，落花时节又逢君。","杜甫","江南逢李龟年","唐","water,wind,flower"],["晴川历历汉阳树，芳草萋萋鹦鹉洲。","崔颢","黄鹤楼","唐","water,sunset,spring"],["客路青山外，行舟绿水前。","王湾","次北固山下","唐","mountain,water,spring"],["三山半落青天外，一水中分白鹭洲。","李白","登金陵凤凰台","唐","mountain,bird,sunset"],["故人西辞黄鹤楼，烟花三月下扬州。","李白","黄鹤楼送孟浩然之广陵","唐","moon,rain,bird"],["两岸猿声啼不住，轻舟已过万重山。","李白","早发白帝城","唐","mountain,water,bird"],["登舟望秋月，空忆谢将军。","李白","夜泊牛渚怀古","唐","moon,water,autumn"],["秋风吹不尽，总是玉关情。","李白","子夜吴歌","唐","wind,autumn,journey"],["仙人垂两足，桂树何团团。","李白","古朗月行节选","唐","moon,flower"],["巫峡啼猿数行泪，衡阳归雁几封书。","高适","送李少府贬峡中王少府贬长沙","唐","bird,sunset,journey"],["独在异乡为异客，每逢佳节倍思亲。","王维","九月九日忆山东兄弟","唐","seclusion,journey"],["劝君更尽一杯酒，西出阳关无故人。","王维","送元二使安西","唐","sunset,journey"],["云母屏风烛影深，长河渐落晓星沉。","李商隐","嫦娥","唐","moon,water,wind"],["沧海月明珠有泪，蓝田日暖玉生烟。","李商隐","锦瑟","唐","moon,water,rain"],["襄阳好风日，留醉与山翁。","王维","汉江临眺","唐","mountain,wind,sunset"],["山中相送罢，日暮掩柴扉。","王维","送别","唐","mountain,seclusion,sunset"],["空山不见人，但闻人语响。","王维","鹿柴","唐","mountain,seclusion"],["人闲桂花落，夜静春山空。","王维","鸟鸣涧","唐","moon,mountain,flower"],["终南阴岭秀，积雪浮云端。","祖咏","终南望余雪","唐","mountain,snow"],["寒雨连江夜入吴，平明送客楚山孤。","王昌龄","芙蓉楼送辛渐","唐","moon,mountain,water"],["秦时明月汉时关，万里长征人未还。","王昌龄","出塞","唐","moon,journey"],["饮马渡秋水，水寒风似刀。","王昌龄","塞下曲","唐","water,snow,wind"],["蝉鸣空桑林，八月萧关道。","王昌龄","塞上曲","唐","moon,bird,autumn"],["木落雁南度，北风江上寒。","孟浩然","早寒有怀","唐","water,snow,wind"],["绿树村边合，青山郭外斜。","孟浩然","过故人庄","唐","mountain,spring"],["北阙休上书，南山归敝庐。","孟浩然","岁暮归南山","唐","mountain,journey"],["移舟泊烟渚，日暮客愁新。","孟浩然","宿建德江","唐","water,rain,sunset"],["不知细叶谁裁出，二月春风似剪刀。","贺知章","咏柳","唐","moon,wind,spring"],["故乡杳无际，江皋闻曙钟。","贺知章","晓发","唐","water,journey"],["最是一年春好处，绝胜烟柳满皇都。","韩愈","早春","唐","rain,flower,spring"],["晚来天欲雪，能饮一杯无。","白居易","问刘十九","唐","snow,sunset"],["关山征戍远，闺阁别离难。","白居易","闺怨词","唐","mountain,journey"],["野火烧不尽，春风吹又生。","白居易","赋得古原草送别","唐","wind,spring"],["九曲黄河万里沙，浪淘风簸自天涯。","刘禹锡","浪淘沙","唐","water,wind,journey"],["湖光秋月两相和，潭面无风镜未磨。","刘禹锡","望洞庭","唐","moon,water,wind"],["朱雀桥边野草花，乌衣巷口夕阳斜。","刘禹锡","乌衣巷","唐","flower,sunset"],["杨柳青青江水平，闻郎江上唱歌声。","刘禹锡","竹枝词","唐","water,flower"],["从今四海为家日，故垒萧萧芦荻秋。","刘禹锡","西塞山怀古","唐","water,wind,flower"],["山围故国周遭在，潮打空城寂寞回。","刘禹锡","石头城","唐","mountain,water,seclusion"],["半卷红旗临易水，霜重鼓寒声不起。","李贺","雁门太守行","唐","moon,snow,wind"],["夜来城外一尺雪，晓驾炭车辗冰辙。","白居易","卖炭翁","唐","moon,snow,spring"],["春种一粒粟，秋收万颗子。","李绅","悯农之二","唐","spring,autumn"],["一道残阳铺水中，半江瑟瑟半江红。","白居易","暮江吟","唐","water,wind,sunset"],["人间四月芳菲尽，山寺桃花始盛开。","白居易","大林寺桃花","唐","moon,mountain,flower"],["大漠沙如雪，燕山月似钩。","李贺","马诗","唐","moon,mountain,snow"],["停车坐爱枫林晚，霜叶红于二月花。","杜牧","山行","唐","moon,snow,flower"],["清明时节雨纷纷，路上行人欲断魂。","杜牧","清明","唐","rain,journey"],["千里莺啼绿映红，水村山郭酒旗风。","杜牧","江南春","唐","mountain,wind,bird"],["天阶夜色凉如水，坐看牵牛织女星。","杜牧","秋夕","唐","moon,autumn"],["惊飞远映碧山去，一树梨花落晚风。","杜牧","鹭鸶","唐","mountain,wind,flower"],["落叶他乡树，寒灯独夜人。","马戴","灞上秋居","唐","moon,snow,seclusion"],["岭外音书绝，经冬复立春。","李频","渡汉江","唐","mountain,spring"],["不论平地与山尖，无限风光尽被占。","罗隐","蜂","唐","mountain,wind"],["猿鸟犹疑畏简书，风云长为护储胥。","李商隐","筹笔驿","唐","wind,bird"],["红楼隔雨相望冷，珠箔飘灯独自归。","李商隐","春雨","唐","rain,wind,seclusion"],["可怜无定河边骨，犹是春闺梦里人。","陈陶","陇西行","唐","water,spring"],["高阁客竟去，小园花乱飞。","李商隐","落花","唐","flower,journey"],["黄叶仍风雨，青楼自管弦。","李商隐","风雨","唐","rain,wind,autumn"],["雁声远过潇湘去，十二楼中月自明。","温庭筠","瑶瑟怨","唐","moon,rain,bird"],["高风汉阳渡，初日郢门山。","温庭筠","送人东归","唐","mountain,water,wind"],["残萤西玉露，早雁拂金河。","许浑","早秋","唐","water,rain,bird"],["红叶晚萧萧，长亭酒一瓢。","许浑","秋日赴阙题潼关驿楼","唐","wind,sunset,autumn"],["寂寂花时闭院门，美人相并立琼轩。","朱庆馀","宫词","唐","flower,seclusion"],["潮落夜江斜月里，两三星火是瓜洲。","张祜","题金陵渡","唐","moon,water,sunset"],["一声何满子，双泪落君前。","张祜","何满子","唐","sunset,autumn"],["落魄江湖载酒行，楚腰纤细掌中轻。","杜牧","遣怀","唐","water,sunset,autumn"],["渚云低暗度，关月冷相随。","崔涂","孤雁","唐","moon,water,journey"],["乱山残雪夜，孤独异乡人。","崔涂","除夜有怀","唐","moon,mountain,snow"],["春风对青冢，白日落梁州。","张乔","书边事","唐","wind,sunset,spring"],["无情最是台城柳，依旧烟笼十里堤。","韦庄","台城","唐","rain,flower"],["清瑟怨遥夜，绕弦风雨哀。","韦庄","章台夜思","唐","moon,rain,wind"],["远道隔江汉，孤舟无岁年。","常建","古意三首一","唐","water,seclusion,journey"],["晓耕翻露草，夜榜响溪石。","柳宗元","溪居","唐","moon,mountain,water"],["天涯静处无征战，兵气销为日月光。","常建","塞下曲四首一","唐","moon,journey"],["北海阴风动地来，明君祠上望龙堆。","常建","塞下曲四首二","唐","water,wind"],["儿歌杨柳叶，妾拂石榴花。","元稹","句","唐","mountain,flower,autumn"],["江瘴节候暖，腊初梅已残。","元稹","寒","唐","water,flower,spring"],["前事风随扇，归心燕在梁。","元稹","新秋","唐","wind,bird,journey"],["念去去千里烟波，暮霭沈沈楚天阔。","柳永","雨霖铃","宋","water,rain,sunset"],["九日重阳节，开门有菊花。","王勃","九日","唐","flower,sunset"],["日夕辨灵药，空山松桂香。","王昌龄","句","唐","moon,mountain,flower"],["朔吹飘夜香，繁霜滋晓白。","柳宗元","早梅","唐","moon,snow,wind"],["东出卢龙塞，浩然客思孤。","高适","塞上","唐","seclusion,journey"],["落日鸿雁度，寒城砧杵愁。","高适","宋中十首五","唐","snow,bird,sunset"],["一身为轻舟，落日西山际。","常建","西山","唐","mountain,water,sunset"],["春归秣陵树，人客远安城。","李清照","临江仙","宋","spring,journey"],["暖风迟日也，别到杏花肥。","李清照","临江仙","宋","wind,flower,spring"],["不肯画堂朱户，春风自在杨花。","王安石","清平乐","宋","wind,flower,spring"],["城阙辅三秦，风烟望五津。","王勃","杜少府之任蜀州","唐","rain,wind"],["停船暂借问，或恐是同乡。","崔颢","长干曲四首一","唐","water,journey"],["金丝玉管咽春空，蜡炬兰灯烧晓色。","柳永","玉楼春","宋","flower,spring"],["几许渔人飞短艇，尽载灯火归村落。","柳永","满江红","宋","sunset,autumn,journey"],["小院回廊春寂寂，山桃溪杏两三栽。","王安石","浣溪沙","宋","mountain,water,flower"],["唯有门前镜湖水，春风不改旧时波。","贺知章","回乡偶书二首二","唐","water,wind,spring"],["况属高风晚，山山黄叶飞。","王勃","山中","唐","mountain,wind,sunset"],["淑气散幽香，满蕙兰汀渚。","柳永","洞仙歌","宋","water,flower,seclusion"],["白日依山尽，黄河入海流。","王之涣","登鹳雀楼","唐","mountain,water"],["日落爱山紫，沙涨省潮回。","姜夔","水调歌头","宋","mountain,water,sunset"],["过春风十里，尽荠麦青青。","姜夔","扬州慢","宋","wind,spring"],["九月九日望乡台，他席他乡送客杯。","王勃","蜀中九日","唐","moon,journey"],["楼头残梦五更钟，花底离情三月雨。","晏殊","玉楼春","宋","moon,rain,flower"],["海上蟠桃易熟，人间好月长圆。","晏殊","破阵子","宋","moon,water,flower"],["燕子欲归时节，高楼昨夜西风。","晏殊","破阵子","宋","moon,wind,bird"],["湖上西风斜日，荷花落尽红英。","晏殊","破阵子","宋","water,wind,flower"],["燕子来时新社，梨花落后清明。","晏殊","破阵子","宋","bird,flower,sunset"],["长记海棠开后，正是伤春时节。","李清照","好事近","宋","water,flower,spring"],["山中兰叶径，城外李桃园。","王勃","春庄","唐","mountain,flower,autumn"],["黄河远上白云间，一片孤城万仞山。","王之涣","凉州词二首一","唐","mountain,water,seclusion"],["归帆去棹残阳里，背西风酒旗斜矗。","王安石","桂枝香","宋","water,wind,sunset"],["陇云晴半雨，边草夏先秋。","贺知章","送人之军","唐","rain,autumn"],["风将衡桂接，地与吴楚邻。","崔颢","赠怀一上人","唐","moon,wind,flower"],["南陌青楼十二重，春风桃李为谁容。","贺知章","望人家桃李花","唐","wind,flower,spring"],["江南多桂树，归客赠生平。","陈子昂","送客","唐","moon,water,flower"],["羌笛何须怨杨柳，春风不度玉门关。","王之涣","横吹曲辞出塞","唐","wind,flower,spring"],["笼鞋浅出鸦头袜，知是凌波漂渺身。","姜夔","鹧鸪天","宋","water,bird"],["三茅钟动西窗晓，诗鬓无端又一春。","姜夔","鹧鸪天","宋","seclusion,spring"],["沙河塘上春寒浅，看了游人缓缓归。","姜夔","鹧鸪天","宋","water,snow,spring"],["瑞脑香消魂梦断，辟寒金小髻鬟松。","李清照","浣溪沙","宋","mountain,snow"],["远岫出山催薄暮，细风吹雨弄轻阴。","李清照","浣溪沙","宋","mountain,rain,wind"],["感惜芳时换，谁知客思悬。","张九龄","秋怀","唐","spring,journey"],["海上生明月，天涯共此时。","张九龄","望月怀远","唐","moon,water,journey"],["星月开天阵，山川列地营。","陈子昂","横吹曲辞出塞","唐","moon,mountain,water"],["春风吹浅草，猎骑何翩翩。","崔颢","赠王威古","唐","wind,spring"],["雁山横代北，狐塞接云中。","陈子昂","送魏大从军","唐","mountain,bird"],["北园新栽桃李枝，根株未固何转移。","崔颢","孟门行","唐","flower,spring"],["紫塞白云断，青春明月初。","陈子昂","春夜别友人二首二","唐","moon,spring"],["兰叶春葳蕤，桂华秋皎洁。","张九龄","感遇十二首一","唐","moon,flower,spring"],["啸叹此寒木，畴昔乃芳蕤。","张九龄","感遇十二首十二","唐","snow,spring"],["故乡杳无际，日暮且孤征。","陈子昂","晚次乐乡县","唐","seclusion,sunset,journey"],["鱼游乐深池，鸟栖欲高枝。","张九龄","感遇十二首三","唐","water,bird"],["昨夜闲潭梦落花，可怜春半不还家。","张若虚","相和歌辞春江花月夜","唐","moon,water,flower"],["石壮马径穷，苔色步缘入。","王湾","奉使登终南山","唐","mountain,flower"],["东归燕从海上去，南来雁向沙头落。","王安石","千秋岁引","宋","water,bird,sunset"],["蓟庭萧瑟故人稀，何处登高且送归。","王之涣","九日送别","唐","autumn,journey"],["耿耿曙河微，神仙此夜稀。","王湾","闰月七日织女","唐","moon,water"],["院逼青霄路，厨和紫禁烟。","王湾","丽正殿赐宴同勒天前烟年四韵应制","唐","rain,journey"],["分班晓入翔鸳阁，直舍旁连浴凤池。","张说","句","唐","water,seclusion,spring"],["秋光照不极，鸟色去无边。","张籍","水","唐","bird,autumn"],["今春偶客耒阳路，凄惨去寻江上墓。","韩愈","题杜工部坟","唐","water,sunset,spring"],["时出为阳山，尔区来趋奔。","张籍","句","唐","mountain,sunset"],["但恐无广路，平地作山丘。","王建","送人","唐","mountain,journey"],["回首不相见，行车秋雨中。","王建","送人","唐","rain,autumn"],["依旧桃花面，频低柳叶眉。","韦庄","女冠子二","唐","flower,autumn"],["忽然太行雪，昨夜飞入来。","孟郊","雪","唐","moon,snow"],["就中一夜东风恶，收红拾紫无遗落。","王建","春去曲","唐","moon,wind,sunset"],["猿啼巫峡夜，月照洞庭波。","李端","送友人","唐","moon,water,bird"],["高歌夜更清，花意晚更多。","孟郊","看花三","唐","moon,flower,sunset"],["节毛风落尽，衣袖雪沾鲜。","王绩","在边三首三","唐","snow,wind,sunset"],["三年此村落，春色入心悲。","孟郊","看花五","唐","sunset,spring,autumn"],["绿槐阴里黄莺语，深院无人春昼午。","韦庄","应天长一","唐","bird,seclusion,spring"],["漠北平无树，关南迥有风。","王绩","在边三首二","唐","wind,journey"],["深夜归来长酩酊，扶入流苏犹未醒。","韦庄","天仙子二","唐","moon,journey"],["鹤警琴亭夜，莺啼酒瓮春。","王绩","句","唐","moon,bird,spring"],["山寺明媚木芍药，野田叫噪官虾蟆。","温庭筠","句一","唐","mountain,seclusion"],["一夜盆倾雨，前湫起毒龙。","张乔","华山","唐","moon,rain"],["波从少海息，云自大风开。","严维","句","唐","water,wind"],["日月双轮见，阴阳两窍通。","许浑","题阴阳井","唐","moon,sunset"],["山僧不语卷帘坐，遥看世间如梦中。","许浑","白云潭禅院在宁国白云山","唐","mountain,wind,seclusion"],["别从仙客求方法，时到僧家问苦空。","张籍","书怀","唐","seclusion,journey"],["雁门霜雪苦，龙城冠盖稀。","王绩","在边三首一","唐","moon,snow,bird"],["猿声寒过涧，树色暮连空。","李端","巫山高","唐","water,snow,bird"],["露滴晓花疑锦绣，风吹寒竹认笙簧。","许浑","句","唐","rain,snow,wind"],["我有松月心，俗骋风霜力。","孟郊","寓言","唐","moon,mountain,snow"],["离人隔楚水，落叶满长安。","贾岛","句三","唐","sunset,autumn"],["落花生芳春，孤月皎清夜。","张说","夜坐","唐","moon,flower,seclusion"],["年深玉颜老，时薄花妆新。","祖咏","古意二首一","唐","flower,spring"],["我听其言未云足，舍我先度横山腹。","韩愈","记梦","唐","mountain,seclusion"],["风雷一夜雨，山川半年行。","贾岛","句一","唐","moon,mountain,water"],["楚王竟何去，独自留巫山。","祖咏","古意二首二","唐","mountain,seclusion"],["半夜长安雨，灯前越客心。","贾岛","送人","唐","moon,rain,journey"],["星汉淡无色，玉镜独空浮。","范成大","水调歌头","宋","moon,seclusion"],["岁晚客多病，风露冷貂裘。","范成大","水调歌头","宋","rain,wind,sunset"],["万里吴船泊，归访菊篱秋。","范成大","水调歌头","宋","water,flower,autumn"],["不须挂岭居天末，但见涔阳在眼前。","戎昱","句二","唐","mountain,sunset"],["新妇矶边月明，女儿浦口潮平。","顾况","句","唐","moon,water,spring"],["寿域遍寰海，直过雪山西。","范成大","水调歌头","宋","mountain,water,snow"],["越客卷帘闲不语，楚娥攀树独含情。","张祜","偶题","唐","wind,seclusion,journey"],["寂寞坐山家，萧条玩物华。","王绩","山家夏日九首一","唐","mountain,seclusion,autumn"],["夜静临江哭，天寒踏雪归。","李端","代村中老人答","唐","moon,water,snow"],["为君持酒听，那肯带春归。","范成大","临江仙","宋","spring,journey"],["自有晚风推楚浪，不劳春色染湘烟。","温庭筠","句","唐","water,rain,wind"],["荣华今异路，风雨昔同忧。","韩愈","秋字","唐","rain,wind,journey"],["园桃绽红艳，郊叶柔绿滋。","宋之问","有所思","唐","flower,spring,autumn"],["幽闺女儿惜颜色，坐见落花长叹息。","宋之问","有所思","唐","flower,seclusion,sunset"],["艳静如笼月，香寒未逐风。","钱起","梨花","唐","moon,snow,wind"],["夏雨莲苞破，秋风桂子雕。","张祜","句","唐","moon,rain,wind"],["分营夜火烧云远，校猎秋雕掠草轻。","张乔","再书边事","唐","moon,autumn"],["煌煌东方星，奈此众客醉。","韩愈","醉后","唐","moon,journey"],["鸟归沙有迹，帆过浪无痕。","宋之问","江亭晚望","唐","water,bird,journey"],["登登山路行时尽，决决溪泉到处闻。","卢纶","山店","唐","mountain,water,journey"],["潇湘何事等闲回，水碧沙明两岸苔。","钱起","归雁","唐","rain,flower,seclusion"],["叹息青青长不改，岁寒霜雪贞松枝。","皇甫冉","寄刘方平","唐","moon,mountain,snow"],["巴客青冥过岭尘，雪崖交映一川春。","张乔","谷口作","唐","mountain,water,snow"],["共期终莫遂，寥落两无成。","张说","河上公","唐","sunset,autumn"],["雁塞五山临汗漫，云州一路出青冥。","皎然","寄常一上人","唐","mountain,bird,journey"],["斑竹年来笋自生，白苹春尽花空落。","张谓","邵陵作","唐","flower,sunset,spring"],["醉眠芳树下，半被落花埋。","卢纶","春词","唐","flower,sunset,spring"],["一年江海恣狂游，夜宿倡家晓上楼。","张祜","到广陵","唐","moon,water,spring"],["待罪居重译，穷愁暮雨秋。","张说","南中送北使二首二","唐","rain,sunset,autumn"],["漫漫一川横渭水，太阳初出五陵高。","司空曙","雪二首一","唐","water,sunset"],["长江风送客，孤馆雨留人。","贾岛","句","唐","water,rain,wind"],["子猷没后知音少，粉节霜筠漫岁寒。","贾岛","竹","唐","moon,snow,autumn"],["遥思桃李日，应赋采苹归。","张说","阙题","唐","flower,journey"],["叶暗青房晚，花明玉井春。","李峤","李","唐","flower,sunset,spring"],["桂林风景异，秋似洛阳春。","宋之问","始安秋日","唐","moon,wind,flower"],["花萼败春多寂寞，叶阴迎夏已清和。","钱起","早夏","唐","flower,seclusion,spring"],["初晴古木猿三叫，未晚阴崖日半规。","郎士元","诗","唐","mountain,bird,sunset"],["和者我云我山，我林我泉元子。","元结","醉歌一","唐","mountain,water"],["惨惨寒日没，北风卷蓬根。","戎昱","塞下曲一","唐","snow,wind"],["高蹄战马三千匹，落日平原秋草中。","戎昱","塞下曲","唐","sunset,autumn"],["西林独鹤引闲步，南涧飞泉清角巾。","李颀","送刘十","唐","water,bird,seclusion"],["嫖姚夜出军，霜雪割人肉。","戎昱","塞下曲二","唐","moon,snow,autumn"],["京口三秋衰叶落，浔阳千里暮潮生。","钱起","送归客","唐","water,sunset,autumn"],["若待秋霜来，兰荪共何有。","戴叔伦","花","唐","moon,snow,flower"],["落日桑柘阴，遥村烟火起。","祖咏","夕次圃田店","唐","rain,sunset,autumn"],["夜坐不厌湖上月，昼行不厌湖上山。","张谓","湖上对酒行","唐","moon,mountain,water"],["晨登凉风台，暮走邯郸道。","储光羲","效古二首一","唐","wind,sunset,autumn"],["绿江深见底，高浪直翻空。","储光羲","江南曲四首一","唐","water,spring"],["夜月霁未好，云泉堪梦归。","钱起","言怀","唐","moon,water,journey"],["古壁丹青色，新花绮绣纹。","李峤","山","唐","mountain,flower,spring"],["霞津锦浪动，月浦练花开。","李峤","江","唐","moon,water,flower"],["春帆江上雨，晓镜鬓边霜。","戴叔伦","雨","唐","moon,water,rain"],["削简龙文见，临池鸟迹舒。","李峤","书","唐","water,bird"],["霜辉简上发，锦字梦中开。","李峤","笔","唐","moon,snow,autumn"],["落花如有意，来去逐船流。","储光羲","江南曲四首三","唐","water,flower,sunset"],["槁叶零宿雨，新鸿叫晴月。","宋之问","卧闻嵩山钟","唐","moon,rain,spring"],["长风吹落西山上，满树萧萧心耳清。","皎然","山雨","唐","mountain,wind,sunset"],["风拂乱灯山磬曙，露沾仙杏石坛春。","杜荀鹤","句","唐","mountain,rain,wind"],["莺啼燕语报新年，马邑龙堆路几千。","皇甫冉","春思","唐","bird,spring,journey"],["不醉郎中桑落酒，教人无奈别离何。","张谓","别韦郎中","唐","sunset,autumn"],["旅怀劳自慰，淅淅有凉风。","祖咏","过郑曲","唐","rain,wind,autumn"],["逐流牵荇叶，绿岸摘芦苗。","储光羲","江南曲四首二","唐","flower,spring,autumn"],["晚风吹行舟，花路入溪口。","綦毋潜","春泛若耶溪","唐","water,wind,flower"],["别愁复经雨，别泪还如霰。","崔曙","对雨送郑陵","唐","rain,snow"],["三晋云山皆北向，二陵风雨自东来。","崔曙","九日登望仙台呈刘明府容","唐","mountain,rain,wind"],["隔江看树色，沿月听歌声。","储光羲","江南曲四首四","唐","moon,water"],["山行分曙色，一路见人稀。","戴叔伦","山行","唐","mountain,journey"],["风搅长空寒骨生，光于晓色报窗明。","杜荀鹤","雪","唐","snow,wind,spring"],["日夕见寒山，便为独往客。","裴迪","辋川集二十首鹿柴","唐","mountain,snow,seclusion"],["千岩曙雪旌门上，十月寒花辇路中。","李颀","送李回","唐","moon,mountain,snow"],["桃源自有长生路，却是秦皇不得知。","元结","桃花题拟","唐","flower,journey"],["今夜月如眉，话别河桥畔。","蔡伸","生查子","宋","moon,water"],["霜寒月满窗，夜永人无寐。","蔡伸","生查子","宋","moon,snow,autumn"],["花影满方床，翠叠屏山杳。","蔡伸","生查子","宋","mountain,flower"],["几番花信风，数点笼丝雨。","蔡伸","生查子","宋","rain,wind,flower"],["我生早孤贱，沦落居此州。","崔曙","送薛据之宋州","唐","seclusion,sunset,autumn"],["雪峰明晚景，风雁急寒天。","皇甫冉","田家作","唐","mountain,snow,wind"],["城下春山路，营中瀚海沙。","皇甫冉","送客","唐","mountain,water,spring"],["坐觉烟尘扫，秋风古北平。","杜审言","送崔融","唐","rain,wind,autumn"],["二月河魁将，三千太乙军。","杨炯","出塞","唐","moon,water"],["河流才辨马，岩路不容车。","杨炯","早行","唐","mountain,water,journey"],["绿笋总成竹，红花亦成子。","崔曙","古意","唐","flower,spring"],["南行更入山深浅，岐路悠悠水自分。","张继","留别","唐","mountain,journey"],["萧萧楚客帆，暮入寒江雨。","柳中庸","江行","唐","water,rain,snow"],["白露含明月，青霞断绛河。","杜审言","七夕","唐","moon,water,rain"],["别离伤晓镜，摇落思秋弦。","柳中庸","秋怨","唐","sunset,spring,autumn"],["黄云雁门郡，日暮风沙里。","李颀","塞下曲","唐","wind,bird,sunset"],["戎鞭腰下插，羌笛雪中吹。","李颀","塞下曲","唐","snow,wind"],["雪暗凋旗画，风多杂鼓声。","杨炯","从军行","唐","snow,wind"],["独有南山桂花发，飞来飞去袭人裾。","卢照邻","长安古意","唐","moon,mountain,flower"],["青松阅世风霜古，翠竹题诗岁月赊。","张继","游灵岩","唐","moon,mountain,snow"],["归来青壁下，又见满篱霜。","朱庆余","山居","唐","moon,mountain,snow"],["贱妾留南楚，征夫向北燕。","杨炯","有所思","唐","bird,journey"],["空林有雪相待，古道无人独还。","张继","归山","唐","snow,seclusion"],["莫怪山前深复浅，清淮一日两回潮。","刘方平","送别","唐","mountain,water"],["春风不肯停仙驭，却向蓬莱看杏花。","张继","上清词","唐","wind,flower,spring"],["尚言春花落，不知秋风起。","刘希夷","春女行","唐","wind,flower,sunset"],["素娥端有恨，烟霭等闲遮。","蔡伸","临江仙","宋","rain,seclusion"],["犹有春山杏，枝枝似薄妆。","刘方平","望夫石","唐","mountain,flower,spring"],["雨雪关山暗，风霜草木稀。","杜审言","赠苏味道","唐","moon,mountain,rain"],["迟日园林悲昔游，今春花鸟作边愁。","杜审言","渡湘江","唐","bird,flower,spring"],["相逢此溪曲，胜托在烟霞。","綦毋潜","若耶溪逢孔九","唐","water,rain,sunset"],["荷花明灭水烟空，惆怅来时径不同。","朱庆余","榜曲","唐","rain,flower"],["薄暮寒蝉三两声，回头故乡千万里。","郎士元","送别","唐","snow,bird,sunset"],["接汉疑星落，依楼似月悬。","卢照邻","十五夜观灯","唐","moon,sunset,autumn"],["莺啼知岁隔，条变识春归。","卢照邻","折杨柳","唐","bird,spring,journey"],["夜来双月满，曙后一星孤。","崔曙","奉试明堂火珠","唐","moon,seclusion"],["窈窕穿苔壁，差池对石坛。","綦毋潜","茅山洞口","唐","mountain,water,flower"],["院落半晴天，风撼梨花树。","周紫芝","生查子","宋","wind,flower,sunset"],["柳困玉楼空，花落红窗暖。","周紫芝","生查子","宋","flower,sunset,spring"],["新欢君未成，往事无人记。","周紫芝","生查子","宋","seclusion,spring"],["门外月横波，帐里人如玉。","周紫芝","生查子","宋","moon,water"],["薄幸不归来，冷落春情绪。","周紫芝","生查子","宋","sunset,spring,autumn"],["天花落不尽，处处鸟衔飞。","綦毋潜","宿龙兴寺","唐","bird,flower,sunset"],["花落曾谁到，诗成独未题。","朱庆余","河亭","唐","flower,seclusion,sunset"],["落叶逐霜风，幽人爱松竹。","元结","石宫四咏三","唐","moon,mountain,snow"],["石宫夏水寒，寒水宜高林。","元结","石宫四咏二","唐","mountain,snow"],["日晚江南望江北，寒鸦飞尽水悠悠。","严维","丹阳送韦参军","唐","water,snow,bird"],["溪上遥闻精舍钟，泊舟微径度深松。","郎士元","柏林寺南望","唐","mountain,water,seclusion"],["鸟鸣知岁隔，条变识春归。","卢照邻","横吹曲辞折杨柳","唐","bird,spring,journey"],["茂林无旧径，修竹起新烟。","严维","经兰亭故池联句","唐","rain,flower,spring"],["送君还旧府，明月满前川。","杨炯","夜送赵纵","唐","moon,water"],["习池风景异，归路满尘埃。","杜审言","登襄阳城","唐","water,wind,journey"],["夜市卖菱藕，春船载绮罗。","杜荀鹤","送人游吴","唐","moon,water,spring"],["鲈蟹正肥时，烟雨新凉日。","毛滂","生查子","宋","rain,spring,autumn"],["烟暖柳醒松，雪尽梅清瘦。","毛滂","生查子","宋","mountain,rain,snow"],["钗上燕犹寒，胜里红偏小。","毛滂","生查子","宋","snow,bird"],["春晚出山城，落日行江岸。","毛滂","生查子","宋","mountain,water,sunset"],["花地锦斑残，月箔波凌乱。","毛滂","生查子","宋","moon,water,flower"],["山云昨夜雨，溪水晓来深。","郎士元","山中即事","唐","moon,mountain,water"],["绿波荡漾玉为砂，青云离披锦作霞。","刘希夷","公子行","唐","water,sunset,spring"],["归去嵩山道，烟花覆青草。","刘希夷","归山","唐","mountain,rain,flower"],["山头禅室挂僧衣，窗外无人溪鸟飞。","綦毋潜","过融上人兰若","唐","mountain,water,bird"],["山深松翠冷，潭静菊花秋。","朱庆余","送僧","唐","mountain,water,flower"],["进膳甘瓜朱李，续命芳兰彩丝。","严维","忆长安五月","唐","flower,spring"],["万乘既已殁，孤舟谁忍还。","郎士元","琴曲歌辞湘夫人","唐","water,seclusion,journey"],["秋天风飒飒，群胡马行疾。","刘希夷","从军行","唐","wind,autumn"],["共说岑山路，今时不可行。","严维","哭灵一上人","唐","mountain,journey"],["芳草绿杨堤畔，一声初听啼莺。","朱敦儒","清平乐","宋","bird,spring"],["春晚不拈红粉，碧窗自录仙书。","朱敦儒","清平乐","宋","sunset,spring"],["向晚红灯入坐，尝新青杏催觞。","王安中","清平乐","宋","flower,sunset,spring"],["解慢不成幽梦，燕泥惊落雕梁。","王安中","清平乐","宋","bird,seclusion,sunset"],["手因春梦有携时，眼到花开无著处。","王安中","玉楼春","宋","flower,spring"],["寂寞归来隐几，梦听帝乐冲融。","朱敦儒","木兰花慢","宋","seclusion,journey"],["休把霜髯老眼，等闲清泪空流。","朱敦儒","木兰花慢","宋","moon,snow,seclusion"],["妒粉尽饶花六六，回风从斗玉纤纤。","王安中","浣溪沙","宋","moon,wind,flower"],["带笑缓摇春笋细，障羞斜映远山横。","王安中","浣溪沙","宋","mountain,spring"]]